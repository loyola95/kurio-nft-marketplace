{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "jsx-a11y",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "public/mockServiceWorker.js",
    "dist",
    "playwright-report",
    "test-results"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": [
        "src/features/**",
        "src/api/**",
        "src/realtime/**",
        "src/components/**",
        "src/routes/**",
        "src/app/**",
        "src/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/mocks/*",
                  "**/mocks/**"
                ],
                "message": "A aplicação não pode depender da camada de mocks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/ui/**",
        "src/routes/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
